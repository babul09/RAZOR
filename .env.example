DATABASE_URL=postgresql://razor:razor@localhost:5432/razor_db
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your_gemini_api_key_here
SECRET_KEY=change_me_in_production
ENVIRONMENT=development

# Razorpay test API keys (https://dashboard.razorpay.com -> Account -> API Keys).
# Leave empty to run the Razorpay tab in demo mode (realistic mock data).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Serve realistic mock data when no test keys are set (default true).
RAZORPAY_MOCK=true
